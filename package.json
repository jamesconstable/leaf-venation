{
  "name": "leaf-venation",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesconstable/leaf-venation.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/jamesconstable/leaf-venation/issues"
  },
  "homepage": "https://github.com/jamesconstable/leaf-venation#readme",
  "private": true,
  "dependencies": {
    "delaunator": "^5.1.0",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/delaunator": "^5.0.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  }
}
